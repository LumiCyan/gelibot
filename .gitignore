# 依赖
node_modules/

# 构建产物
dist/
dist-release*/
release/

# 内置的 SnowLuma 运行包（97 MB，不进仓库；由 scripts/fetch-snowluma.mjs 拉取）
snowluma/

# 本地运行数据（配置文件里可能有 RCON 密码与 Token，绝不能提交）
data/

# SnowLuma 运行配置（内含真实的 accessToken / 账号信息，绝不能提交）
config/

# 运行日志（体积大且含账号信息）
logs/

# 打包输出
dist-release*/

# 图标预览（由 scripts/make-icon.py 生成，非必需）
build/icon-preview*.png

# 打包临时目录
.stage/

# 编辑器 / 系统
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini

# 日志
*.log
npm-debug.log*

# 环境变量（可能含 token）
.env
.env.local

# 密钥与证书
*.pem
*.p12
*.pfx
*.key
